---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/content';
import { getReadingMinutes } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { withBase } from '../lib/urls';
import { SITE } from '../config/site';
interface Props { post: Post; headings: MarkdownHeading[]; newer?: Post; older?: Post; }
const { post, headings, newer, older } = Astro.props;
const minutes = getReadingMinutes(post.body ?? '');
const date = post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} article={{ pubDate: post.data.pubDate, updatedDate: post.data.updatedDate, tags: post.data.tags }}>
  <article class="post-page">
    <header class="post-header content-shell">
      <a class="back-link" href={withBase('/')}>返回文章</a>
      <div class="post-kicker"><span>{post.data.category}</span><span>{minutes} 分钟阅读</span></div>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <p class="post-byline"><time datetime={post.data.pubDate.toISOString()}>{date}</time>　{SITE.author}</p>
    </header>
    <div class="post-grid content-shell">
      <div class="post-main">
        <div class="reading-card">
          <TableOfContents headings={headings} mode="mobile" />
          <div class="prose"><slot /></div>
          <nav class="post-neighbors" aria-label="相邻文章">
            {newer ? <a href={withBase(`/posts/${newer.id}/`)}><small>上一篇</small>{newer.data.title}</a> : <span />}
            {older && <a href={withBase(`/posts/${older.id}/`)}><small>下一篇</small>{older.data.title}</a>}
          </nav>
        </div>
        <GiscusComments />
      </div>
      <TableOfContents headings={headings} mode="desktop" />
    </div>
  </article>
</BaseLayout>
