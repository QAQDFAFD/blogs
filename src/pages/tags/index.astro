---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/content';
import { withBase } from '../../lib/urls';
const tags = getTagCounts(await getPublishedPosts());
---
<BaseLayout title="标签"><div class="content-shell listing-page"><h1>文章标签</h1><div class="tag-grid">{tags.map(([tag, count]) => <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}><span>{tag}</span><small>{count} 篇</small></a>)}</div></div></BaseLayout>
