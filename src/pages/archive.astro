---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/urls';
const posts = await getPublishedPosts();
const groups = new Map<number, typeof posts>();
posts.forEach((post) => { const year = post.data.pubDate.getFullYear(); groups.set(year, [...(groups.get(year) ?? []), post]); });
---
<BaseLayout title="归档" description="JiaJun Li 的文章归档">
  <div class="content-shell listing-page">
    <h1>文章归档</h1>
    {[...groups.entries()].map(([year, yearPosts]) => (
      <section class="archive-year"><h2>{year}</h2><ol>{yearPosts.map((post) => <li><time>{post.data.pubDate.toLocaleDateString('zh-CN', { month:'2-digit', day:'2-digit' })}</time><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></li>)}</ol></section>
    ))}
  </div>
</BaseLayout>
