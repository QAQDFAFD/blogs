---
import { SITE } from '../config/site';
import { withBase } from '../lib/urls';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  ['文章', '/'],
  ['归档', '/archive/'],
  ['标签', '/tags/'],
  ['关于', '/about/'],
] as const;
---
<header class="site-header">
  <div class="nav-shell">
    <a class="wordmark" href={withBase('/')}><span class="brand-mark">JL</span><span>{SITE.author}</span></a>
    <div class="nav-actions">
      <nav class="desktop-nav" aria-label="主导航">
        {links.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
        <a class="nav-cta" href={SITE.github} rel="me external">GitHub</a>
      </nav>
      <ThemeToggle />
      <details class="mobile-nav">
        <summary>菜单</summary>
        <nav aria-label="移动端主导航">
          {links.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
          <a href={SITE.github} rel="me external">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>
