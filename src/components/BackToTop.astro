---
import arrowBarToUpIcon from '@tabler/icons/outline/arrow-bar-to-up.svg?raw';
---
<button class="back-to-top" type="button" aria-label="返回页面顶部" aria-hidden="true" tabindex="-1">
  <span aria-hidden="true" set:html={arrowBarToUpIcon} />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.back-to-top');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (button && header) {
    const setVisible = (visible: boolean) => {
      button.toggleAttribute('data-visible', visible);
      button.tabIndex = visible ? 0 : -1;
      button.setAttribute('aria-hidden', String(!visible));
      if (!visible && document.activeElement === button) button.blur();
    };

    const observer = new IntersectionObserver(([entry]) => {
      setVisible(!entry.isIntersecting);
    });

    observer.observe(header);
    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
