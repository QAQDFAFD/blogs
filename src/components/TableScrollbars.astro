<script>
  const MIN_THUMB_WIDTH = 44;
  const TRACK_INSET = 4;
  const clamp = (value: number, minimum: number, maximum: number) => Math.min(Math.max(value, minimum), maximum);

  document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table, index) => {
    const bar = document.createElement('div');
    const thumb = document.createElement('div');

    table.id ||= `article-table-${index + 1}`;
    bar.className = 'table-scrollbar';
    bar.role = 'scrollbar';
    bar.ariaLabel = `横向滚动表格 ${index + 1}`;
    bar.ariaOrientation = 'horizontal';
    bar.setAttribute('aria-controls', table.id);
    bar.ariaValueMin = '0';
    bar.hidden = true;
    bar.tabIndex = -1;
    thumb.className = 'table-scrollbar-thumb';
    thumb.setAttribute('aria-hidden', 'true');
    bar.append(thumb);
    table.after(bar);

    let maxScroll = 0;
    let maxThumbTravel = 0;
    let dragStartX = 0;
    let dragStartScroll = 0;

    const updatePosition = () => {
      const thumbOffset = maxScroll ? table.scrollLeft / maxScroll * maxThumbTravel : 0;
      thumb.style.transform = `translateX(${thumbOffset}px)`;
      bar.ariaValueNow = String(Math.round(table.scrollLeft));
      bar.ariaValueText = `已横向滚动 ${Math.round(maxScroll ? table.scrollLeft / maxScroll * 100 : 0)}%`;
    };

    const measure = () => {
      maxScroll = Math.max(0, table.scrollWidth - table.clientWidth);
      const overflowing = maxScroll > 0;

      bar.hidden = !overflowing;
      bar.tabIndex = overflowing ? 0 : -1;
      table.toggleAttribute('data-custom-scrollbar', overflowing);
      if (!overflowing) return;

      bar.style.width = `${table.clientWidth}px`;
      const trackWidth = Math.max(0, bar.clientWidth - TRACK_INSET);
      const thumbWidth = Math.min(trackWidth, Math.max(MIN_THUMB_WIDTH, trackWidth * table.clientWidth / table.scrollWidth));
      maxThumbTravel = Math.max(0, trackWidth - thumbWidth);

      thumb.style.width = `${thumbWidth}px`;
      bar.ariaValueMax = String(Math.round(maxScroll));
      updatePosition();
    };

    table.addEventListener('scroll', updatePosition, { passive: true });

    bar.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.target === thumb || maxScroll === 0 || (event.pointerType === 'mouse' && event.button !== 0)) return;
      event.preventDefault();
      bar.focus();
      const bounds = bar.getBoundingClientRect();
      const thumbWidth = thumb.getBoundingClientRect().width;
      const pointerOffset = event.clientX - bounds.left - bar.clientLeft - TRACK_INSET / 2;
      const targetOffset = clamp(pointerOffset - thumbWidth / 2, 0, maxThumbTravel);
      table.scrollLeft = maxThumbTravel ? targetOffset / maxThumbTravel * maxScroll : 0;
    });

    thumb.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;
      event.preventDefault();
      event.stopPropagation();
      bar.focus();
      dragStartX = event.clientX;
      dragStartScroll = table.scrollLeft;
      thumb.setPointerCapture(event.pointerId);
    });

    thumb.addEventListener('pointermove', (event) => {
      if (!thumb.hasPointerCapture(event.pointerId) || maxThumbTravel === 0) return;
      table.scrollLeft = dragStartScroll + (event.clientX - dragStartX) / maxThumbTravel * maxScroll;
    });

    thumb.addEventListener('pointerup', (event) => {
      if (thumb.hasPointerCapture(event.pointerId)) thumb.releasePointerCapture(event.pointerId);
    });

    bar.addEventListener('keydown', (event) => {
      let nextScroll = table.scrollLeft;
      switch (event.key) {
        case 'ArrowLeft':
          nextScroll -= 80;
          break;
        case 'ArrowRight':
          nextScroll += 80;
          break;
        case 'Home':
          nextScroll = 0;
          break;
        case 'End':
          nextScroll = maxScroll;
          break;
        default:
          return;
      }
      event.preventDefault();
      table.scrollLeft = clamp(nextScroll, 0, maxScroll);
    });

    bar.addEventListener('wheel', (event) => {
      const horizontalDelta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.shiftKey ? event.deltaY : 0;
      if (!horizontalDelta) return;
      event.preventDefault();
      table.scrollLeft = clamp(table.scrollLeft + horizontalDelta, 0, maxScroll);
    }, { passive: false });

    const resizeObserver = new ResizeObserver(measure);
    resizeObserver.observe(table);
    if (table.parentElement) resizeObserver.observe(table.parentElement);
    document.fonts.ready.then(measure);
    requestAnimationFrame(measure);
  });
</script>
